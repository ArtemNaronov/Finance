{
  "name": "finance-ai",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --ignore-scripts && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:all": "npm run build --prefix client",
    "start": "cross-env SERVE_CLIENT=true npm run start --prefix server",
    "test": "npm run test --prefix server",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bundle:node": "node scripts/download-bundle-node.mjs",
    "cap:sync": "npm run build --prefix client && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@tauri-apps/cli": "^2.11.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  }
}
