# GateLLM API — как в Ai-lab: https://gatellm.ru/dashboard
GATELLM_API_KEY=sk-your-api-key
# Не используйте api.gatellm.ru — домен не работает
GATELLM_BASE_URL=https://gatellm.ru/v1
GATELLM_MODEL=openai/gpt-4o-mini

# Альтернативные имена (совместимость с Ai-lab):
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://gatellm.ru/v1
# OPENAI_MODEL=openai/gpt-4o-mini

# Server
PORT=3001
